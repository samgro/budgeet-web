# Base URL of the budgeet-hono API (SDG-211). Must be 127.0.0.1, never
# localhost — localhost can resolve to ::1 while the API listens on IPv4
# only, which surfaces as an intermittent ECONNREFUSED.
API_BASE_URL=http://127.0.0.1:3000

# Bearer token — must match API_TOKEN in budgeet-hono's own .env.local
# (see SDG-180). Generate with:
#   openssl rand -hex 32
API_TOKEN=
